<Window x:Class="Kino_Radosteva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kino_Radosteva"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <Button Click="OpenKino" Content="Кинотеатры" Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10,10,10,10" Width="100" Background="#FFD09DE9" BorderBrush="#FFD09DE9"/>
        <Button Click="OpenAfish" Content="Афиши" Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,115,0" Width="100" Background="#FF62DFD6" BorderBrush="#FF62DFD6"/>
        <Frame x:Name="frame" NavigationUIVisibility="Hidden" Margin="0,40,0,0"/>
    </Grid>
</Window>
