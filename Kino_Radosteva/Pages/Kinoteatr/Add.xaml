<Page x:Class="Kino_Radosteva.Pages.Kinoteatr.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kino_Radosteva.Pages.Kinoteatr"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Add">

    <Grid Background="Gainsboro">
        <Grid Margin="20" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100px"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/Images/Kinoteatr.png" Width="80" Height="80" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"/>
            <Label Content="Наименование:" Grid.Column="1" VerticalAlignment="Top" Margin="10"/>
            <TextBox x:Name="name" Height="25" Grid.Column="1" VerticalAlignment="Top" Margin="10,40,10,10" />

            <Label Content="Количество залов:" Grid.Column="1" VerticalAlignment="Top" Margin="10,72,10,0"/>
            <TextBox x:Name="countZal" Height="25" Grid.Column="1" VerticalAlignment="Top" Margin="10,102,10,0" />

            <Label Content="Количество:" Grid.Column="2" VerticalAlignment="Top" Margin="10"/>
            <TextBox x:Name="count" Height="25" Grid.Column="2" VerticalAlignment="Top" Margin="10,40,10,10" />

            <Button x:Name="btnAdd" Click="AddRecord" Content="Добавить" Grid.Column="2" HorizontalAlignment="Right" Height="25" Width="100" Background="#FF47E868" BorderBrush="#FF47E868" Foreground="Black" VerticalAlignment="Top" Margin="0,100,10,0" />
        </Grid>
    </Grid>
</Page>
