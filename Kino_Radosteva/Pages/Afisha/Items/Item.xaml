<UserControl x:Class="Kino_Radosteva.Pages.Afisha.Items.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kino_Radosteva.Pages.Afisha.Items"
             mc:Ignorable="d">
    <Grid Margin="5" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100px"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Source="/Images/afisha.png" Width="80" Height="80" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"/>
        <Label Content="Кинотеатр:" Grid.Column="1" VerticalAlignment="Top" Margin="10"/>
        <TextBox x:Name="kinoteatrs" Height="25" Grid.Column="1" VerticalAlignment="Top" Margin="10,40,10,10" IsEnabled="False"/>

        <Label Content="Наименование:" Grid.Column="1" VerticalAlignment="Top" Margin="10,72,10,0"/>
        <TextBox x:Name="name" Height="25" Grid.Column="1" VerticalAlignment="Top" Margin="10,102,10,0" IsEnabled="False"/>

        <Label Content="Дата:" Grid.Column="2" VerticalAlignment="Top" Margin="10"/>
        <DatePicker x:Name="date" Height="25" Grid.Column="2" VerticalAlignment="Top" Margin="10,40,10,10" HorizontalAlignment="Left" Width="187" IsEnabled="False"/>
        <TextBox x:Name="time" Grid.Column="2" Height="25" VerticalAlignment="Top" Margin="202,40,10,0" IsEnabled="False"/>

        <Button Click="EditRecord" Content="Изменить" HorizontalAlignment="Center" Height="26" Width="80" Background="#FF47E868" BorderBrush="#FF47E868" Foreground="Black" VerticalAlignment="Top" Margin="0,102,0,0" />
        <Button Click="DeleteRecord" Content="Удалить" HorizontalAlignment="Center" Height="26" Width="80" Background="#FFDA4127" BorderBrush="#FFDA4127" Foreground="Black" VerticalAlignment="Top" Margin="0,133,0,10" />

        <Label Content="Стоимость:" Grid.Column="2" VerticalAlignment="Top" Margin="10,72,10,0"/>
        <TextBox x:Name="price" Height="25" Grid.Column="2" VerticalAlignment="Top" Margin="10,102,10,0" IsEnabled="False"/>
    </Grid>
</UserControl>
